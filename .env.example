# Development proxy target (set in the shell before starting Astro).
# Default: http://127.0.0.1:8787
# BAREBLEKK_API_ORIGIN=http://127.0.0.1:8787

# Browser API base. Leave this unchanged for the development proxy.
# In production, route /api to the backend on the same site, or configure
# a same-site HTTPS API and add the frontend origin to ALLOWED_ORIGINS.
PUBLIC_API_BASE_URL=/api/v1
