

---
import '../styles/landing.css';
import Icon from '../components/LandingIcon.astro';

const services = [
  { number: '01', title: 'Asesoramiento', text: 'Lo ayudamos a identificar la tecnología adecuada para sus materiales, aplicaciones y objetivos de producción.', icon: 'chat' },
  { number: '02', title: 'Equipos e insumos', text: 'Acercamos soluciones de impresión digital e insumos para acompañar el trabajo de su empresa.', icon: 'printer' },
  { number: '03', title: 'Servicio técnico', text: 'Acompañamos el funcionamiento de su equipo con asistencia técnica y orientación para su mantenimiento.', icon: 'tool' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Soluciones de impresión digital con el respaldo de Bareblekk. Conozca tecnologías Mimaki para gráfica, impresión textil y UV, con asesoramiento y servicio técnico." />
    <meta name="theme-color" content="#29548D" />
    <title>Bareblekk | Tecnología de impresión, respaldo en cada paso</title>
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="preload" href="/fonts/poppins-regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/poppins-semibold.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand-logo" href="#inicio" aria-label="Bareblekk, inicio"><img src="/brand/bareblekk.svg" alt="Bareblekk" width="212" height="40" /></a>
        <nav class="desktop-nav" aria-label="Navegación principal">
          <a href="#catalogo">Soluciones de impresión</a><a href="#nosotros">Nosotros</a>
          <a href="#contacto" class="button button-small">Conversemos <Icon name="arrow" /></a>
        </nav>
        <details class="mobile-menu">
          <summary aria-label="Abrir menú de navegación"><Icon name="menu" /><span>Menú</span></summary>
          <nav aria-label="Navegación móvil"><a href="#catalogo">Soluciones de impresión</a><a href="#nosotros">Nosotros</a><a href="#contacto">Conversemos <Icon name="arrow" /></a></nav>
        </details>
      </div>
    </header>
    <main id="contenido">
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="container hero-inner">
          <div class="hero-copy">
            <p class="eyebrow"><span class="short-line"></span> TECNOLOGÍA DE IMPRESIÓN DIGITAL</p>
            <h1 id="hero-title">Aca va un slogan o <strong>mensaje representativo</strong></h1>
            <p class="hero-description">lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam auctor, nisl eget ultricies tincidunt, nunc nisl aliquam nisl, eget ultricies nunc nisl eget nunc.</p>
            <div class="hero-actions"><a href="#catalogo" class="button">Explore las soluciones <Icon name="arrow" /></a><a href="#contacto" class="text-link">Reciba asesoramiento <Icon name="arrow-up" /></a></div>
            <div class="hero-footnote"><span class="brand-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>Equipos, insumos y soporte.<br /><strong>Todo para su próxima impresión.</strong></span></div>
          </div>
          <div class="hero-visual">
            <div class="hero-image-heading"><span>PRECISIÓN. COLOR. POSIBILIDADES.</span><Icon name="plus" /></div>
            <div id="hero-product"><p class="hero-image-fallback">Explore las posibilidades de impresión.</p></div>
          </div>
        </div>
      </section>
      <section class="trust-strip" aria-label="Respaldo y servicios">
        <div class="container trust-inner">
          <div class="official-brand"><img class="mimaki-logo" src="/brand/mimaki.png" alt="Mimaki" width="320" height="59" loading="lazy" /><span>Distribuidor oficial<br /><strong>Respaldo para su producción</strong></span></div>
          <div class="trust-item"><Icon name="printer" /><span>Equipos e insumos</span></div><div class="trust-item"><Icon name="tool" /><span>Servicio técnico</span></div><div class="trust-item"><Icon name="chat" /><span>Asesoramiento especializado</span></div>
        </div>
      </section>
      <section class="catalog section-space" id="catalogo" aria-labelledby="catalog-title">
        <div class="container">
          <div class="section-heading"><div><p class="eyebrow">SOLUCIONES DE IMPRESIÓN</p><h2 id="catalog-title">Una tecnología para<br />cada posibilidad.</h2></div><p>Encuentre el punto de partida para su próximo proyecto. Explore las aplicaciones y consulte a nuestro equipo por modelos y disponibilidad.</p></div>
          <p id="catalog-status" class="catalog-status" role="status">Cargando equipos…</p>
          <button id="catalog-retry" class="button" type="button" hidden>Intentar nuevamente</button>
          <div class="solutions-grid" id="public-products" aria-busy="true"></div>
          <noscript><p class="catalog-status">Active JavaScript para consultar los equipos publicados o <a href="#contacto">solicite asesoramiento</a>.</p><style>#catalog-status{display:none}</style></noscript>
          <div class="catalog-help"><span><Icon name="chat" /> ¿Necesita orientación para elegir?</span><a class="text-link" href="#contacto">Lo ayudamos a encontrar su equipo <Icon name="arrow-up" /></a></div>
        </div>
      </section>
      <section class="about section-space" id="nosotros" aria-labelledby="about-title">
        <div class="container about-inner">
          <div class="about-copy"><p class="eyebrow">EL RESPALDO DE BAREBLEKK</p><h2 id="about-title">La tecnología importa.<br /><span>Quién lo acompaña,<br />también.</span></h2><p>Detrás de cada equipo hay un proyecto. Por eso, nuestro trabajo comienza por escuchar lo que usted necesita y acompañarlo con una solución de impresión adecuada.</p><a href="#contacto" class="button button-light">Hablemos de su proyecto <Icon name="arrow" /></a><span class="about-dots brand-dots" aria-hidden="true"><i></i><i></i><i></i></span></div>
          <div class="services">{services.map(service => <article class="service"><span class="service-number">{service.number}</span><div><h3>{service.title}</h3><p>{service.text}</p></div><Icon name={service.icon} /></article>)}</div>
        </div>
      </section>
      <section class="contact section-space" id="contacto" aria-labelledby="contact-title">
        <div class="container contact-inner">
          <div class="contact-copy"><p class="eyebrow">HABLEMOS DE SU PRÓXIMO PASO</p><h2 id="contact-title">Su próximo proyecto<br />comienza con una<br /><span>conversación.</span></h2><p>Cuéntenos qué necesita imprimir. Nuestro equipo lo orientará sobre tecnologías, equipos e insumos para su proyecto.</p><a class="email-link" href="mailto:info@bareblekk.com"><span class="contact-icon"><Icon name="mail" /></span><span><small>También puede escribirnos a</small>info@bareblekk.com</span><Icon name="arrow-up" /></a></div>
          <form class="contact-form" id="inquiry-form" action="mailto:info@bareblekk.com" method="post" enctype="text/plain">
            <div class="form-heading"><h3>¿En qué podemos ayudarlo?</h3><p>Los campos con * son obligatorios.</p></div>
            <div class="form-row"><label>Nombre y apellido *<input name="name" autocomplete="name" placeholder="Su nombre completo" maxlength="100" required /></label><label>Empresa<input name="company" autocomplete="organization" placeholder="Nombre de su empresa" maxlength="120" /></label></div>
            <label>Correo electrónico *<input name="email" type="email" autocomplete="email" placeholder="usted@empresa.com" maxlength="160" required /></label>
            <label>Me interesa<select id="interest" name="interest"><option value="Asesoramiento general">Asesoramiento general</option><optgroup id="product-interests" label="Equipos publicados"></optgroup><option value="Insumos">Insumos</option><option value="Servicio técnico">Servicio técnico</option></select></label>
            <label>Cuéntenos sobre su proyecto *<textarea name="message" rows="3" placeholder="¿Qué le gustaría imprimir o qué necesita resolver?" maxlength="1500" required></textarea></label>
            <p class="form-note" id="form-note">Al continuar se abrirá su aplicación de correo con la consulta preparada para que usted pueda revisarla y enviarla.</p>
            <button class="button submit-button" type="submit" aria-describedby="form-note">Preparar consulta <Icon name="arrow" /></button>
            <p class="form-status" role="status" id="form-status" hidden></p>
            <noscript><p class="form-note">Puede escribir directamente a <a href="mailto:info@bareblekk.com">info@bareblekk.com</a> si su aplicación de correo no admite este formulario.</p></noscript>
          </form>
        </div>
      </section>
    </main>
    <footer class="site-footer"><div class="container"><div class="footer-main"><div><a class="brand-logo" href="#inicio" aria-label="Bareblekk, volver al inicio"><img src="/brand/bareblekk.svg" alt="Bareblekk" width="212" height="40" loading="lazy" /></a><p>Equipos, insumos y soporte<br />en tecnología de impresión digital.</p></div><nav aria-label="Navegación del pie de página"><a href="#catalogo">Soluciones de impresión</a><a href="#nosotros">Nosotros</a><a href="#contacto">Contacto</a></nav><a href="#inicio" class="back-top">Volver al inicio <Icon name="arrow-up" /></a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Bareblekk. Todos los derechos reservados.</span><span>Tecnología de impresión. Respaldo en cada paso.</span></div></div></footer>
    <script>
      import { mountLandingCatalog } from '../lib/landing-catalog';
      let cleanupCatalog = mountLandingCatalog();
      window.addEventListener('pagehide', () => cleanupCatalog());
      window.addEventListener('pageshow', event => { if (event.persisted) cleanupCatalog = mountLandingCatalog(); });
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
      });
      document.addEventListener('click', event => {
        if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
      });
      const interest = document.querySelector<HTMLSelectElement>('#interest');
      document.addEventListener('click', event => {
        const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('[data-interest]') : null;
        if (interest && link) interest.value = link.dataset.interest ?? 'Asesoramiento general';
      });
      const form = document.querySelector<HTMLFormElement>('#inquiry-form');
      const status = document.querySelector<HTMLParagraphElement>('#form-status');
      form?.addEventListener('submit', event => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const data = new FormData(form);
        const value = (key: string) => String(data.get(key) ?? '').trim();
        const subject = `Consulta Bareblekk: ${value('interest')}`;
        const body = `Nombre: ${value('name')}\nEmpresa: ${value('company') || 'No indicada'}\nCorreo: ${value('email')}\nInterés: ${value('interest')}\n\n${value('message')}`;
        window.location.href = `mailto:info@bareblekk.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        if (status) { status.hidden = false; status.textContent = 'Su consulta está preparada. Complete el envío desde su aplicación de correo. Si no se abre, escríbanos a info@bareblekk.com.'; }
      });
    </script>
  </body>
</html>
